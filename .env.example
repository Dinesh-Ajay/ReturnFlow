# Database Configuration
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/returnflow_db?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://root:root@localhost:3306/returnflow_db?charset=utf8mb4

# Supabase / PostgreSQL Support (Optional for Cloud Deployments)
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# SUPABASE_URL=https://[project-id].supabase.co
# SUPABASE_KEY=eyJh...

# Data Generation Settings
RANDOM_SEED=20261022
REFERENCE_DATE=2026-10-22
DATA_PROFILE=starter
BATCH_SIZE=1000

# Better Auth & Security
AUTH_SECRET=returnflow-super-secret-key-32-chars-minimum-prod
ENVIRONMENT=development

# Operations Manager Initial Account Bootstrap
INITIAL_ADMIN_EMAIL=dineshajay874@gmail.com
INITIAL_ADMIN_NAME=Dinesh Ajay
INITIAL_ADMIN_ROLE=Operations Manager
INITIAL_ADMIN_PASSWORD=your_secure_initial_password_here

# Gmail SMTP Configuration (TLS Port 587)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password_here

# OTP Security Parameters
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Google Analytics
GA_MEASUREMENT_ID=G-RETURNFLOW01

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
