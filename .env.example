# Database Configuration
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/returnflow_db?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://root:root@localhost:3306/returnflow_db?charset=utf8mb4

# Supabase / PostgreSQL Support (Optional for Cloud Deployments)
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# SUPABASE_URL=https://[project-id].supabase.co
# SUPABASE_KEY=eyJh...

# Data Generation Settings
RANDOM_SEED=20261022
REFERENCE_DATE=2026-10-22
DATA_PROFILE=starter
BATCH_SIZE=1000

# Better Auth & Security
AUTH_SECRET=returnflow-super-secret-key-32-chars-minimum-prod
ENVIRONMENT=development

# Google Analytics
GA_MEASUREMENT_ID=G-RETURNFLOW01

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
